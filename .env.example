# =====================================================================
# Configuración del Generador de Actas - Consensus S.A.S.
# =====================================================================

# Clave de API de Google Gemini (Google AI Studio / Vertex AI)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo principal de Gemini (Recomendado de alta velocidad y estabilidad: gemini-3.6-flash o gemini-3.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Clave para firmar la cookie de sesión de los consultores (obligatoria en Vercel).
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Los datos de firma (nombre, cargo, celular) ahora los registra cada consultor en la app.
SESSION_SECRET=cambia_esta_clave

# Configuración del Servidor Web (Opcional)
PORT=8000
HOST=127.0.0.1
